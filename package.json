{
  "name": "a-share-etf-rebound-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create a-share-etf-alerts",
    "db:migrate:local": "wrangler d1 execute a-share-etf-alerts --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute a-share-etf-alerts --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250601.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.20.0"
  }
}
